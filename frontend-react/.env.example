# Copy to .env.local for local development.

# Backend base URL. Empty = same origin (use the Vite dev proxy on /api).
VITE_API_BASE_URL=

# Force mock data regardless of backend availability (demos, screenshots).
VITE_USE_MOCKS=false

# Dev-server proxy target for /api (vite.config.ts).
VITE_API_PROXY=http://localhost:8080
