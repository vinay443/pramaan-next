      { "id": "MW-03", "controlId": "MW-HSTS", "framework": "DPSC", "title": "HSTS response header configured" },
      { "id": "MW-04", "controlId": "MW-AUTODEPLOY", "framework": "C-SITE", "title": "Hot auto-deploy disabled (Tomcat)" }
    ] },
    { "type": "tls", "technologies": ["tls"], "checks": [
      { "id": "TLS-01", "controlId": "TLS-PROTOCOL-VERSION", "framework": "PCI_DSS", "title": "Negotiated TLS version is 1.2 or higher" },
      { "id": "TLS-02", "controlId": "TLS-CERT-EXPIRY", "framework": "C-SITE", "title": "Leaf certificate has > 30 days remaining" },
      { "id": "TLS-03", "controlId": "TLS-KEY-STRENGTH", "framework": "C-SITE", "title": "Certificate key meets minimum strength" },
      { "id": "TLS-04", "controlId": "TLS-CERT-TRUST", "framework": "DPSC", "title": "Certificate is CA-issued (not self-signed)" }
    ] }
